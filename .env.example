# Application Settings
APP_NAME=OpsPilot AI
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local development defaults only. Change these in your private .env.
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot_db
DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot_db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
# Local development value only. Use a strong secret in real environments.
JWT_SECRET_KEY=change-me-local-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Provider
LLM_PROVIDER=deterministic

# OpenAI Configuration (Future)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Local Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Use local LLM (Ollama) by default
USE_LOCAL_LLM=true
